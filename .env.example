# Copy to .env.local and fill in. NEVER commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini AI (Google AI Studio)
GEMINI_API_KEY=

# Paystack (paystack.com → Settings → API Keys)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# Push notifications (Web Push / VAPID — no Firebase needed)
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@scholarx.com

# Waitlist email alerts (resend.com → API Keys)
RESEND_API_KEY=
WAITLIST_EMAIL=
